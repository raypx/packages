{
  "name": "voidmix",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "docs",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "doctor": "bun scripts/doctor.ts",
    "toolchain:check": "bun scripts/check-toolchain.ts",
    "build": "bun --bun turbo run build",
    "check": "bun --check --tsconfig-override tsconfig.json && bun --bun turbo run check",
    "test": "bun run test:toolchain && bun --bun turbo run test",
    "test:toolchain": "bun --bun vp test --run --config vitest.config.ts",
    "lint": "bun --bun vp check",
    "format": "bun --bun vp fmt",
    "verify": "bun run doctor && bun run toolchain:check && bun run lint && bun run check && bun run test:toolchain && bun --bun turbo run test build && bun run pack:check && bun run release:check",
    "pack:check": "bun scripts/check-packages.ts",
    "release:check": "bun scripts/check-releases.ts",
    "changeset": "bun --bun ./node_modules/@changesets/cli/bin.js",
    "version-packages": "bun run changeset version && bun install --ignore-scripts && bun run format",
    "release:plan": "bun scripts/release.ts plan",
    "release:pack": "bun scripts/release.ts pack",
    "release:publish": "bun scripts/release.ts publish",
    "docs:dev": "bun --bun turbo run dev --filter=docs",
    "docs:build": "bun --bun turbo run build --filter=docs",
    "docs:preview": "bun run --cwd docs preview",
    "docs:check": "bun run --cwd docs check"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "@voidmix/tsconfig": "workspace:*",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vite-plus": "1.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "error"
    },
    "runtime": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "24.15.0"
  },
  "packageManager": "bun@1.4.3"
}
