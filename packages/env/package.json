{
  "name": "@voidmix/env",
  "version": "0.0.0-alpha.2",
  "description": "Typed Zod environment validation with composable presets and browser access guards.",
  "homepage": "https://github.com/raypx/voidmix/tree/main/packages/env",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raypx/voidmix.git",
    "directory": "packages/env"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "import": "./dist/runtime.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --passWithNoTests --exclude '**/component.test.{ts,tsx}' --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "bun --bun vp test --run --passWithNoTests integration.test",
    "test:component": "bun --bun vp test --run --passWithNoTests component.test",
    "test:coverage": "bun --bun vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov",
    "build": "bun --bun vp pack",
    "dev": "bun --bun vp pack --watch",
    "pack:check": "bun pm pack --dry-run --ignore-scripts"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.3",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=20"
  }
}
