{
  "name": "@voidmix/drizzle",
  "version": "0.0.0-alpha.0",
  "description": "Drizzle extensions for PostgreSQL with postgres.js: explicit SQL, JSONB and diagnostics helpers.",
  "homepage": "https://github.com/raypx/voidmix/tree/main/packages/drizzle",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raypx/voidmix.git",
    "directory": "packages/drizzle"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./postgres": {
      "types": "./dist/postgres.d.mts",
      "import": "./dist/postgres.mjs"
    },
    "./errors": {
      "types": "./dist/errors.d.mts",
      "import": "./dist/errors.mjs"
    },
    "./results": {
      "types": "./dist/results.d.mts",
      "import": "./dist/results.mjs"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.mts",
      "import": "./dist/diagnostics.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun --check --tsconfig-override tsconfig.json",
    "test": "bun --bun vp test --run",
    "test:unit": "bun --bun vp test --run --passWithNoTests --exclude '**/component.test.{ts,tsx}' --exclude '**/*.component.test.{ts,tsx}' --exclude '**/*.integration.test.{ts,tsx}'",
    "test:integration": "bun --bun vp test --run --passWithNoTests integration.test",
    "test:component": "bun --bun vp test --run --passWithNoTests component.test",
    "test:coverage": "bun --bun vp test --run --passWithNoTests --coverage --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov",
    "build": "bun --bun vp pack",
    "dev": "bun --bun vp pack --watch",
    "pack:check": "bun pm pack --dry-run --ignore-scripts"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "postgres": "3.4.9"
  },
  "peerDependencies": {
    "drizzle-orm": "1.0.0-rc.5-5935859",
    "postgres": "3.4.9"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
