{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    // Drizzle's shared declarations reference optional drivers for all
    // dialects. Check consumer API inference without installing them.
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
