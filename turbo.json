{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "check": {
      "dependsOn": ["^check"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["check", "^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalDependencies": [
    "scripts/testing/**",
    "docs/**",
    "README.md",
    ".changeset/README.md",
    "PRODUCT.md",
    "packages/*/README.md",
    "packages/*/NOTICE.md",
    "packages/*/LICENSE"
  ]
}
